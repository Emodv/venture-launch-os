{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venture-launch-os.local/schemas/agent-capability-manifest.schema.json",
  "title": "VLA Agent Capability Manifest",
  "description": "Machine-readable contract for what an AI agent can discover and safely do with a VLA-powered venture. Publish a validated instance at /.well-known/agent.json. Do not advertise capabilities that are not production-verified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "venture", "offers", "actions", "policies", "verification"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "venture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "canonical_url", "description", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["validation", "pilot", "live", "paused"]},
        "languages": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "markets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "pricing", "eligibility"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["test", "available", "waitlist", "unavailable"]},
          "pricing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["fixed", "starting_at", "range", "quote_required", "free", "unknown"]},
              "currency": {"type": ["string", "null"]},
              "amount": {"type": ["number", "null"], "minimum": 0},
              "min": {"type": ["number", "null"], "minimum": 0},
              "max": {"type": ["number", "null"], "minimum": 0},
              "unit": {"type": ["string", "null"]},
              "final_price_requires_confirmation": {"type": "boolean", "default": true}
            }
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "geographies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "exclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          },
          "sla": {"type": ["string", "null"], "description": "Publish only a verified SLA; otherwise null."}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "readiness", "method", "endpoint", "auth", "consequence", "idempotency", "receipt"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["browse", "qualify", "quote", "book", "buy", "apply", "subscribe", "refer", "status", "escalate_to_human"]},
          "readiness": {"enum": ["documented", "sandbox", "production_verified", "disabled"]},
          "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "endpoint": {"type": "string", "format": "uri"},
          "auth": {"enum": ["none", "api_key", "oauth2", "session", "other"]},
          "consequence": {"enum": ["read_only", "reversible", "commercial_commitment", "financial", "legal_or_sensitive"]},
          "requires_human_confirmation": {"type": "boolean", "default": false},
          "input_schema": {"type": ["string", "null"], "format": "uri-reference"},
          "output_schema": {"type": ["string", "null"], "format": "uri-reference"},
          "idempotency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supported"],
            "properties": {
              "supported": {"type": "boolean"},
              "header": {"type": ["string", "null"]}
            }
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["returned"],
            "properties": {
              "returned": {"type": "boolean"},
              "identifier_field": {"type": ["string", "null"]},
              "status_url_field": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth", "negotiation", "privacy"],
      "properties": {
        "truth": {"type": "string", "minLength": 1},
        "negotiation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["autonomous_discount_allowed", "human_approval_required_for_exceptions"],
          "properties": {
            "autonomous_discount_allowed": {"type": "boolean"},
            "max_discount_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "human_approval_required_for_exceptions": {"type": "boolean"}
          }
        },
        "privacy": {"type": "string", "minLength": 1},
        "terms_url": {"type": ["string", "null"], "format": "uri"},
        "privacy_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_verified_at", "verified_actions", "changelog_url"],
      "properties": {
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "changelog_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
