# VLA is the persistent agent. Choose the intelligence provider beneath it.
# Values: openai | anthropic | gemini | xai | auto
VLA_PROVIDER=openai

# Never commit real keys.
OPENAI_API_KEY=
VLA_OPENAI_MODEL=
VLA_OPENAI_AGENT_MODEL=

ANTHROPIC_API_KEY=
VLA_ANTHROPIC_MODEL=
# Full OpenAI Agents SDK Any-LLM route, configured for the current provider/model.
# Example shape only: any-llm/anthropic/<current-model-id>
VLA_ANTHROPIC_AGENT_MODEL=

GEMINI_API_KEY=
VLA_GEMINI_MODEL=
# Example shape only: any-llm/gemini/<current-model-id>
VLA_GEMINI_AGENT_MODEL=

XAI_API_KEY=
VLA_XAI_MODEL=
# Example shape only: any-llm/xai/<current-model-id>
VLA_XAI_AGENT_MODEL=

# Legacy compatibility. Used only when an explicit OpenAI agent model is not set.
VLA_MODEL=
VLA_STATE_DIR=./data/ventures
